# Auth0 - get these from https://manage.auth0.com → Applications → your app
AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
AUTH0_CLIENT_ID=YOUR_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Generate with: openssl rand -hex 32
AUTH0_SECRET=YOUR_32_BYTE_HEX_SECRET

# Your app's URL (leave as-is for local dev)
APP_BASE_URL=http://localhost:3000

# Server-only: used to gate /admin page access (never sent to the browser)
ADMIN_EMAIL=your-email@example.com
# Client-side: used only to show the Admin chip/link in the nav dropdown
NEXT_PUBLIC_ADMIN_EMAIL=your-email@example.com
