# Auth0 - get these from https://manage.auth0.com → Applications → your app
AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
AUTH0_CLIENT_ID=YOUR_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Generate with: openssl rand -hex 32
AUTH0_SECRET=YOUR_32_BYTE_HEX_SECRET

# Your app's URL (leave as-is for local dev)
APP_BASE_URL=http://localhost:3000

# Server-only: gates /admin, /audio and every admin API route.
# Never reaches the browser — server components send the client a plain isAdmin
# boolean instead of the address. Do NOT add a NEXT_PUBLIC_ copy of this.
ADMIN_EMAIL=your-email@example.com

# Database
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Generate with: openssl rand -hex 32
JWT_SECRET=YOUR_32_BYTE_HEX_SECRET

# Cloudflare R2 — private bucket backing the Audio library.
# Account ID is on the R2 overview page; keys come from R2 > Manage API Tokens
# (Object Read & Write, scoped to this bucket). The Audio feature returns 503
# until all four are set. Remember the bucket CORS policy, or uploads and
# playback fail with opaque CORS errors even though the presigned URLs are valid.
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET=your-bucket-name
